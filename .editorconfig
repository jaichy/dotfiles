root = true

# -------------------------------
# Global Go-like formatting rules
# -------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go uses tabs by default
indent_style = tab
indent_size = 4

# No alignment rules (Go never aligns things)
# Many editors ignore these, but they discourage auto-alignment
ij_continuation_indent_size = 0

# -------------------------------------
# C# (explicit Roslyn brace style rules)
# -------------------------------------
[*.cs]
csharp_new_line_before_open_brace = none
csharp_new_line_before_open_brace_types = none
csharp_new_line_before_open_brace_methods = none
csharp_new_line_before_open_brace_accessors = none
csharp_new_line_before_open_brace_anonymous_methods = none
csharp_new_line_before_open_brace_control_blocks = none
csharp_new_line_before_open_brace_lambdas = none

# Avoid extra blank lines (Go is strict)
csharp_style_allow_embedded_statements_on_same_line = true
csharp_style_allow_blank_line_after_colon_in_constructor_initializer = false

# -------------------------------------
# Java
# -------------------------------------
[*.java]
# Brace on same line (K&R)
ij_java_brace_style = end_of_line

# No extra blank lines (Go-like strictness)
ij_java_blank_lines_before_class = 0
ij_java_blank_lines_after_class = 0
ij_java_blank_lines_around_method = 0

# Tabs like Go
indent_style = tab
indent_size = 4

# -------------------------------------
# JavaScript / TypeScript
# -------------------------------------
[*.{js,jsx,ts,tsx}]
# K&R brace style
ij_javascript_brace_style = end_of_line
ij_typescript_brace_style = end_of_line

# Tabs like Go
indent_style = tab
indent_size = 4

# Remove extra semicolons — Go avoids unnecessary tokens
ij_javascript_force_semicolon_style = false

# -------------------------------------
# C / C++
# -------------------------------------
[*.{c,cpp,h,hpp}]
# Brace on same line
ij_c_brace_style = end_of_line
ij_cpp_brace_style = end_of_line

indent_style = tab
indent_size = 4

# No alignment (Go doesn't align columns)
ij_c_align_function_parameters = false
ij_cpp_align_function_parameters = false

# -------------------------------------
# Rust
# -------------------------------------
[*.rs]
# Rustfmt already uses same-line braces; reinforce it
rust_brace_style = same_line

indent_style = tab
indent_size = 4

# Avoid visual alignments
rust_align_comments = false
rust_align_struct_fields = false

# -------------------------------------
# Python (does not use braces, but follow Go consistency)
# -------------------------------------
[*.py]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# -------------------------------------
# JSON / YAML
# -------------------------------------
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = true
