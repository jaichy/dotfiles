#!/bin/bash

TARGET="${1:-.}" 

echo "Cleaning hidden macOS files from: $TARGET..."

find "$TARGET" -name '.DS_Store' -delete
find "$TARGET" -name '._*' -delete
find "$TARGET" -name '.Spotlight-V100' -exec rm -rf {} +
find "$TARGET" -name '.fseventsd' -exec rm -rf {} +
find "$TARGET" -name '.Trash' -exec rm -rf {} +

echo "Done! Hidden files removed."
