# ===========================================
# Dotfiles Repository .gitignore
# ===========================================

# MacOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux desktop environment caches
.cache/
.local/share/Trash/

# Common editor/IDE swap & backup files
*~
*.swp
*.swo
*.swm
*.tmp
*.bak

# VSCode settings you don't want to sync
.vscode/
.code-workspace

# Git
.gitkeep

# Shell history (never commit this!)
.bash_history
.zsh_history
.fish_history

# SSH keys (never version-control private keys!)
.ssh/id_*
.ssh/known_hosts

# GPG
.gnupg/

# Credentials & auth files
.aws/
.kube/
.config/gcloud/
.netrc
.pypirc

# OS-specific configuration caches
.config/*/cache/
.config/*/log/

# Python-related
__pycache__/
*.pyc

# Node-related
node_modules/

# Applications that store machine-specific state
.config/Code/Cache/
.config/Code/CachedData/
.config/Slack/
.config/discord/
